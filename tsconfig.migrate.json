{
  // Compiles the migration runner alone into dist/scripts/migrate.js.
  //
  // tsconfig.build.json deliberately excludes scripts/ so that seed/backfill/
  // import tooling never ships in the production artifact. But the migration
  // runner is the one script a deployment *does* need: it runs as the host's
  // pre-deploy step, where ts-node and tsconfig-paths — both devDependencies —
  // may not be installed. So it gets its own compile, with plain `node` as the
  // entry point (`npm run db:migrate:prod`).
  //
  // Ordering matters: nest-cli.json sets deleteOutDir, so `npm run build` runs
  // `nest build` FIRST and this second, or this output is wiped.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    // The root config is incremental; sharing one .tsbuildinfo across two
    // different file sets makes the second compile decide it has nothing to do.
    "incremental": false
  },
  "include": ["scripts/migrate.ts"]
}
