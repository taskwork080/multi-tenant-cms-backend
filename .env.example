# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5000

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Direct connection (IPv6). If your network is IPv4-only, use the Session Pooler
# string from Supabase Dashboard > Connect instead (aws-*.pooler.supabase.com:5432).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Optional: legacy HS256 JWT secret. If unset, tokens are verified via JWKS.
SUPABASE_JWT_SECRET=
# SERVER-ONLY. Bypasses every RLS policy and can mint sessions for any account.
# Required by /api/admin/* (create users, reset passwords, ban/unban).
# Never mirror this into a NEXT_PUBLIC_* variable or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: connect as the app_api role (drizzle/0011_app_api_role.sql), not postgres.
# postgres has rolbypassrls, which silently disables every RLS policy.

# --- Platform admin ---
# Where recovery/invite links send the user back to.
FRONTEND_URL=http://localhost:5000
# Lets a super admin set a user's password directly instead of sending a
# recovery link. That is silent account takeover with only the audit log as a
# trace, so it is opt-in. Leave false unless you have a specific need.
PLATFORM_ALLOW_PASSWORD_SET=false

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cms-assets
R2_PUBLIC_URL=

# --- Storefront ---
# Comma-separated roots whose subdomains map to tenant slugs, e.g. with
# STOREFRONT_ROOT_DOMAIN=storefronts.example.com the host acme.storefronts.example.com
# resolves to tenant "acme". Leave empty to disable subdomain routing; custom
# domains and /s/<slug> path routing work either way.
STOREFRONT_ROOT_DOMAIN=

# --- API docs ---
# Swagger at /docs is unauthenticated by construction. On outside production;
# set true to expose it in production anyway.
ENABLE_DOCS=

# --- Auth dev bypass (NEVER enable in production) ---
AUTH_DEV_BYPASS=false
