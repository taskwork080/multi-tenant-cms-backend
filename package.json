{
  "name": "multi-tenant-cms-backend",
  "version": "0.1.0",
  "description": "NestJS backend for the multi-tenant CMS admin (Supabase Postgres + Auth, Drizzle ORM, Cloudflare R2, WebSocket chat)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "ts-node -r tsconfig-paths/register scripts/migrate.ts",
    "db:seed": "ts-node -T -r tsconfig-paths/register scripts/seed.ts",
    "db:reset-users": "ts-node -T -r tsconfig-paths/register scripts/reset-users.ts",
    "db:backfill": "ts-node -r tsconfig-paths/register scripts/backfill-rbac.ts",
    "user:create": "ts-node -T -r tsconfig-paths/register scripts/create-user.ts",
    "roles:audit": "ts-node -r tsconfig-paths/register scripts/audit-roles.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.0.0",
    "drizzle-orm": "^0.44.0",
    "drizzle-zod": "^0.8.0",
    "helmet": "^8.3.0",
    "jose": "^6.0.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.8.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
